{
  "name": "abdquest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Abd's Quest — personal RPG habit / prayer / fitness tracker",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.39.5",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "^3.2.6"
  }
}
